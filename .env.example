# HengSeng Sentiment Pipeline - Environment Configuration
# Copy this to .env and fill in your API keys

# === REQUIRED API KEYS ===
APIFY_API_TOKEN=your_apify_token_here
EXA_API_KEY=your_exa_api_key_here

# === OPTIONAL NEWS API FALLBACK ===
TAVILY_API_KEY=your_tavily_api_key_here

# === OPTIONAL ===
# Override default exchanges/tickers in config/exchanges.yaml
# LOG_LEVEL=INFO

